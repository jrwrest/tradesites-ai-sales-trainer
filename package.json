{
  "name": "tradesites-ai-sales-trainer",
  "version": "1.0.0",
  "description": "Free open-source AI sales trainer for contractors winning bigger commercial jobs.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "eval:fixtures": "node scripts/evaluate-fixtures.js",
    "pb:start": "./pocketbase serve --http 127.0.0.1:8090 --hooksDir ./pb_hooks",
    "validate:auth": "node scripts/validate-pocketbase-login.mjs",
    "smoke": "node scripts/smoke.mjs",
    "data:retention": "node scripts/run-retention.js",
    "data:backup": "node scripts/backup-data.js",
    "data:verify": "node scripts/verify-backup.js",
    "data:restore": "node scripts/restore-backup.js",
    "signup:resend-approval": "node scripts/resend-signup-approval.js",
    "signup:resend-password": "node scripts/resend-signup-password.js",
    "signup:reconcile-password": "node scripts/reconcile-signup-password.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "node --test"
  },
  "keywords": [
    "sales-training",
    "cold-calling",
    "contractors",
    "commercial-solar",
    "roleplay"
  ],
  "author": "James R Wrest",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
