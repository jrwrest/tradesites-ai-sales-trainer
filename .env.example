# Local app
HOST=127.0.0.1
PORT=3137
DATA_DIR=data
# Production requires absolute DATA_DIR/BACKUP_ROOT paths and this explicit single-process storage mode.
# NODE_ENV=production
# STORAGE_MODE=single-instance-json
# BACKUP_ROOT=/absolute/path/outside-data-dir
# DATA_RETENTION_ENABLED=1
# SESSION_RETENTION_DAYS=90
# SIGNUP_REQUEST_RETENTION_DAYS=30
# RETENTION_INTERVAL_MS=86400000

# Auth
AUTH_REQUIRED=1
# disabled: no account creation; approval: verify email + admin approve + password setup; open: public account creation.
SIGNUP_MODE=disabled
# Legacy flag: set to 1 only for local open signup testing when SIGNUP_MODE is unset.
SIGNUP_ENABLED=0
POCKETBASE_URL=http://127.0.0.1:8090
# AUTH_RATE_LIMIT_ATTEMPTS=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_KEYS=10000

# Optional approval-mode links, email, and notifications
PUBLIC_BASE_URL=http://127.0.0.1:3137
# ACCESS_APPROVAL_TOKEN=replace-with-a-long-random-secret
# Required when SIGNUP_MODE=approval
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=replace-with-your-brevo-smtp-user
# SMTP_PASS=replace-with-your-brevo-smtp-password
# SMTP_FROM=trainer@example.com
# SMTP_FROM_NAME=Tradesites AI Sales Trainer
# Optional API provider
# BREVO_API_KEY=replace-with-your-brevo-api-key
# MAIL_FROM=Tradesites AI Sales Trainer <trainer@example.com>
# Optional fallback provider
# RESEND_API_KEY=replace-with-your-resend-key
# SIGNUP_EMAIL_TOKEN_TTL_HOURS=24
# SIGNUP_APPROVAL_TOKEN_TTL_HOURS=72
# SIGNUP_PASSWORD_TOKEN_TTL_HOURS=24
# SIGNUP_EMAIL_RESEND_COOLDOWN_SECONDS=300
# EMAIL_DELIVERY_TIMEOUT_MS=10000
# SIGNUP_NOTIFICATION_TIMEOUT_MS=10000
# Admin recipient for verified signup approval links (preferred)
# SIGNUP_APPROVAL_EMAIL=owner@example.com
# Optional fallback if admin email delivery fails or is not configured
# TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Optional OpenClaw customer brain
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=replace-with-a-secret
# Use a dedicated agent; production rejects the shared main agent.
# OPENCLAW_AGENT_ID=sales-trainer-customer
# Acknowledge that only synthetic practice dialogue, never real prospect PII, may be sent to this boundary.
# OPENCLAW_DATA_POLICY_ACK=1
# OPENCLAW_GATEWAY_HEALTH_TIMEOUT_MS=3000
# One wall-clock budget shared by gateway connect, agent start, and reply wait. Maximum: 40000.
# OPENCLAW_GATEWAY_TIMEOUT_MS=40000

# Optional command customer brain
# CODEX_BRAIN_COMMAND=["node","scripts/codex-brain.mjs"]

# Optional v1 dialogue-state guardrails. Leave off for rollback to the older turn-based brain path.
# DIALOGUE_MANAGER_ENABLED=1
# Optional LLM rendering for dialogue/flow-guard replies. Keep off until local QA/canary passes.
# DIALOGUE_LLM_RENDER_ENABLED=0
# DIALOGUE_LLM_RENDER_TIMEOUT_MS=10000
# DIALOGUE_LLM_RENDER_RETRY_ON_VIOLATION=0
# DIALOGUE_LLM_RENDER_MAX_CONCURRENT_PER_SESSION=1
# DIALOGUE_LLM_RENDER_MAX_CONCURRENT_PER_USER=2
# DIALOGUE_LLM_RENDER_MAX_CONCURRENT_GLOBAL=10
# CODEX_MODEL=gpt-5.4-mini
