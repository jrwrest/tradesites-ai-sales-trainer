NODE_ENV=production
STORAGE_MODE=single-instance-json
BACKUP_ROOT=/var/backups/cold-call-trainer/data
DATA_RETENTION_ENABLED=1
SESSION_RETENTION_DAYS=90
SIGNUP_REQUEST_RETENTION_DAYS=30
RETENTION_INTERVAL_MS=86400000
# Approval-mode deployments set SIGNUP_APPROVAL_EMAIL in the private service environment.
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are an optional paired fallback.
EMAIL_DELIVERY_TIMEOUT_MS=10000
SIGNUP_NOTIFICATION_TIMEOUT_MS=10000
# Put a random 32+ character POCKETBASE_PROVISIONING_SECRET in the separate,
# root-owned /etc/cold-call-trainer.provisioning.env loaded by both services.
OPENCLAW_AGENT_ID=sales-trainer-customer
OPENCLAW_DATA_POLICY_ACK=1
OPENCLAW_GATEWAY_HEALTH_TIMEOUT_MS=3000
OPENCLAW_GATEWAY_TIMEOUT_MS=40000
